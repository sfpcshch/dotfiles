# Noctalia macOS Traffic Light Theme for Labwc
# Dark modern titlebar with macOS-style colored circle buttons

border.width: 1

# Window titlebar padding - zero padding on right and top edge so close button hits corner
window.titlebar.padding.width: 0
window.titlebar.padding.height: 0

# Window border colors
window.active.border.color: #45475a
window.inactive.border.color: #313244

# Window titlebar background
window.active.title.bg.color: #1e1e2e
window.inactive.title.bg.color: #181825

# Window title text
window.active.label.text.color: #cdd6f4
window.inactive.label.text.color: #6c7086
window.label.text.justify: left

# Button sizing - 24x24 square hitbox, 4px spacing for symmetric 11px circle-to-circle gap
window.button.width: 24
window.button.height: 24
window.button.spacing: 4

# Button hover overlay - transparent (SVGs handle hover)
window.button.hover.bg.color: #00000000
window.button.hover.bg.corner-radius: 0

# Button image colors (fallback for XBM)
window.active.button.unpressed.image.color: #cdd6f4
window.inactive.button.unpressed.image.color: #6c7086

# Window drop-shadows
window.active.shadow.size: 60
window.inactive.shadow.size: 40
window.active.shadow.color: #00000060
window.inactive.shadow.color: #00000040

# Menu styling - dark theme
menu.border.width: 1
menu.border.color: #45475a
menu.items.bg.color: #1e1e2e
menu.items.text.color: #cdd6f4
menu.items.active.bg.color: #45475a
menu.items.active.text.color: #cdd6f4
menu.items.padding.x: 10
menu.items.padding.y: 6
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 4
menu.separator.color: #45475a
menu.title.bg.color: #313244
menu.title.text.color: #cdd6f4

# OSD (Alt-Tab window switcher) - dark theme
osd.bg.color: #1e1e2e
osd.border.color: #45475a
osd.border.width: 1
osd.label.text.color: #cdd6f4

osd.window-switcher.style-classic.padding: 6
osd.window-switcher.style-classic.item.padding.x: 12
osd.window-switcher.style-classic.item.padding.y: 4
osd.window-switcher.style-classic.item.active.border.width: 2
osd.window-switcher.style-classic.item.active.border.color: #89b4fa
osd.window-switcher.style-classic.item.active.bg.color: #313244

# Snapping overlay
snapping.overlay.region.bg.color: #89b4fa40
snapping.overlay.edge.bg.color: #89b4fa40
snapping.overlay.region.border.width: 2
snapping.overlay.edge.border.width: 2
snapping.overlay.region.border.color: #89b4fa
snapping.overlay.edge.border.color: #89b4fa
