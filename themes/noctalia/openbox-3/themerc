# window border
window.active.border.color: #a1cfd3
window.inactive.border.color: #b8cacb

# ToggleKeybinds status indicator
window.active.indicator.toggled-keybind.color: #ffb4ab

# window titlebar background
window.active.title.bg.color: #a1cfd3
window.inactive.title.bg.color: #b8cacb

window.active.label.text.color: #01363a
window.inactive.label.text.color: #233335
window.label.text.justify: center

# window button hover overlay
window.button.hover.bg.color: #282a2a

# window buttons
window.active.button.unpressed.image.color: #01363a
window.inactive.button.unpressed.image.color: #01363a

# menu
menu.border.color: #01363a
menu.items.bg.color: #a1cfd3
menu.items.text.color: #01363a
menu.items.active.bg.color: #b8cacb
menu.items.active.text.color: #233335
menu.separator.color: #01363a
menu.title.bg.color: #a1cfd3
menu.title.text.color: #01363a

# window buttons & titlebar height (Windows 10 rectangular style)
window.button.width: 44
window.button.height: 20
window.button.spacing: 0
window.titlebar.padding.width: 0

# on screen display (Alt+Tab window-cycle dialog - fixed neutral dark)
osd.bg.color: #1a1a1e
osd.border.color: #ffffff20
osd.border.width: 1
osd.label.text.color: #e5e5e5
osd.window-switcher.style-thumbnail.item.active.border.color: #ffffff40
osd.window-switcher.style-thumbnail.item.active.bg.color: #ffffff15
osd.window-switcher.preview.border.color: #ffffff30
