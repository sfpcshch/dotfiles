# window border
window.active.border.color: #c3c5d8
window.inactive.border.color: #c7c5ce

# ToggleKeybinds status indicator
window.active.indicator.toggled-keybind.color: #ffb4ab

# window titlebar background
window.active.title.bg.color: #c3c5d8
window.inactive.title.bg.color: #c7c5ce

window.active.label.text.color: #2d303e
window.inactive.label.text.color: #2f3036
window.label.text.justify: center

# window button hover overlay
window.button.hover.bg.color: #2a2a2b

# window buttons
window.active.button.unpressed.image.color: #2d303e
window.inactive.button.unpressed.image.color: #2d303e

# menu
menu.border.color: #2d303e
menu.items.bg.color: #c3c5d8
menu.items.text.color: #2d303e
menu.items.active.bg.color: #c7c5ce
menu.items.active.text.color: #2f3036
menu.separator.color: #2d303e
menu.title.bg.color: #c3c5d8
menu.title.text.color: #2d303e

# on screen display (window-cycle dialog)
osd.bg.color: #c3c5d8
osd.border.color: #2d303e
osd.label.text.color: #2d303e
osd.window-switcher.preview.border.color: #919096
