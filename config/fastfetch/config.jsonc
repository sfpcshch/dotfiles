{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "cachyos",
    "padding": {
      "right": 2,
      "left": 0
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "green"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#36}┌─── System ─────────────────────────────{#}"
    },
    {
      "type": "os",
      "key": "│ 󰣇 OS",
      "format": "{3}"
    },
    {
      "type": "kernel",
      "key": "│  Kernel",
      "format": "{1} {2}"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Packages"
    },
    {
      "type": "shell",
      "key": "│  Shell"
    },
    {
      "type": "custom",
      "format": "{#36}├─── Desktop ────────────────────────────{#}"
    },
    {
      "type": "wm",
      "key": "│ 󱂬 WM"
    },
    {
      "type": "theme",
      "key": "│ 󰉼 Theme"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Display",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "terminal",
      "key": "│  Terminal"
    },
    {
      "type": "custom",
      "format": "{#36}├─── Hardware ───────────────────────────{#}"
    },
    {
      "type": "host",
      "key": "│ 󰌢 Model",
      "format": "{2}"
    },
    {
      "type": "cpu",
      "key": "│ 󰍛 CPU",
      "format": "{1} ({4}) @ {7}"
    },
    {
      "type": "gpu",
      "key": "│ 󰾲 GPU 1",
      "format": "{2}",
      "hideType": "integrated"
    },
    {
      "type": "gpu",
      "key": "│ 󰾲 GPU 2",
      "format": "Radeon Vega Mobile",
      "hideType": "discrete"
    },
    {
      "type": "memory",
      "key": "│  Memory"
    },
    {
      "type": "swap",
      "key": "│ 󰓡 Swap"
    },
    {
      "type": "disk",
      "key": "│ 󰋊 Disk",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": "│  Battery",
      "format": "{4} [{5}]"
    },
    {
      "type": "custom",
      "format": "{#36}└─── Colors ─────────────────────────────{#}"
    },
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
