{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "Windows",
    "padding": {
      "right": 3,
      "left": 1
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "green"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "format": "{3}"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": " Kernel",
      "format": "{1} {2}"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "display",
      "key": "󰍹 Display",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "wm",
      "key": "󱂬 WM"
    },
    {
      "type": "theme",
      "key": "󰉼 Theme"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "format": "{1} ({4}) @ {7}"
    },
    {
      "type": "gpu",
      "key": "󰾲 GPU 1",
      "format": "{2}",
      "hideType": "integrated"
    },
    {
      "type": "gpu",
      "key": "󰾲 GPU 2",
      "format": "Radeon Vega Mobile",
      "hideType": "discrete"
    },
    {
      "type": "memory",
      "key": " Memory"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    "break",
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
