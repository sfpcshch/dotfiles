{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "cachyos",
    "padding": {
      "right": 3,
      "left": 0
    },
    "color": {
      "1": "#f4b963",
      "2": "#dfc063"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#f4b9a8",
      "title": "#dfc0b8"
    },
    "percent": {
      "color": {
        "green": "#d6c68f",
        "yellow": "#f4b9a8",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇",
      "format": "{3}"
    },
    {
      "type": "host",
      "key": "󰌢",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "",
      "format": "{1} {2}"
    },
    {
      "type": "uptime",
      "key": "󰅐"
    },
    {
      "type": "processes",
      "key": "󰒋",
      "format": "{1} ({2} threads)"
    },
    {
      "type": "packages",
      "key": "󰏖"
    },
    {
      "type": "break"
    },
    {
      "type": "wm",
      "key": "󱂬"
    },
    {
      "type": "terminal",
      "key": ""
    },
    {
      "type": "shell",
      "key": ""
    },
    {
      "type": "display",
      "key": "󰍹",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "theme",
      "key": "󰉼"
    },
    {
      "type": "break"
    },
    {
      "type": "cpu",
      "key": "󰍛",
      "format": "{1} ({4}) @ {7}"
    },
    {
      "type": "gpu",
      "key": "󰾲",
      "format": "{2}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": ""
    },
    {
      "type": "disk",
      "key": "󰋊",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": "",
      "format": "{4} [{5}]"
    },
    {
      "type": "localip",
      "key": "󰩟",
      "format": "{ipv4}"
    },
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
