{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "  ██████  █████   ██████ ██   ██ ██    ██  ██████  ███████ \n ██      ██   ██ ██      ██   ██  ██  ██  ██    ██ ██      \n ██      ███████ ██      ███████   ████   ██    ██ ███████ \n ██      ██   ██ ██      ██   ██    ██    ██    ██      ██ \n  ██████ ██   ██  ██████ ██   ██    ██     ██████  ███████ ",
    "position": "top",
    "padding": {
      "top": 0,
      "bottom": 1
    },
    "color": {
      "1": "cyan"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "green"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "custom",
      "format": "{#36}┌──────────┐{#}"
    },
    {
      "type": "os",
      "key": "│ OS       │",
      "format": "󰣇 {3}"
    },
    {
      "type": "host",
      "key": "│ Host     │",
      "format": "󰌢 {2}"
    },
    {
      "type": "kernel",
      "key": "│ Kernel   │",
      "format": " {1} {2}"
    },
    {
      "type": "uptime",
      "key": "│ Uptime   │",
      "format": "󰅐 {2}h {3}m"
    },
    {
      "type": "packages",
      "key": "│ Packages │",
      "format": "󰏖 {all} (pacman)"
    },
    {
      "type": "shell",
      "key": "│ Shell    │",
      "format": " {1} {4}"
    },
    {
      "type": "wm",
      "key": "│ Desktop  │",
      "format": "󱂬 {1} ({3})"
    },
    {
      "type": "cpu",
      "key": "│ CPU      │",
      "format": "󰍛 {1} ({4})"
    },
    {
      "type": "gpu",
      "key": "│ GPU      │",
      "format": "󰾲 {2}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "│ Memory   │",
      "format": " {1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": "│ Disk     │",
      "folders": "/",
      "format": "󰋊 {1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": "│ Battery  │",
      "format": " {4} [{5}]"
    },
    {
      "type": "custom",
      "format": "{#36}└──────────┘{#}  {#31}● {#32}● {#33}● {#34}● {#35}● {#36}● {#37}●"
    }
  ]
}
