{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "cachyos",
    "padding": {
      "right": 3,
      "left": 0
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "blue"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇",
      "format": "{3}"
    },
    {
      "type": "host",
      "key": "󰌢",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "",
      "format": "{1} {2}"
    },
    {
      "type": "uptime",
      "key": "󰅐"
    },
    {
      "type": "packages",
      "key": "󰏖"
    },
    {
      "type": "shell",
      "key": ""
    },
    {
      "type": "display",
      "key": "󰍹",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "wm",
      "key": "󱂬"
    },
    {
      "type": "lm",
      "key": "󰧨"
    },
    {
      "type": "theme",
      "key": "󰉼"
    },
    {
      "type": "icons",
      "key": "󰀻"
    },
    {
      "type": "terminal",
      "key": ""
    },
    {
      "type": "cpu",
      "key": "󰍛",
      "format": "{1} ({4}) @ {7}"
    },
    {
      "type": "gpu",
      "key": "󰾲",
      "format": "{2}",
      "hideType": "integrated"
    },
    {
      "type": "gpu",
      "key": "󰾲",
      "format": "Radeon Vega Mobile",
      "hideType": "discrete"
    },
    {
      "type": "memory",
      "key": ""
    },
    {
      "type": "swap",
      "key": "󰓡"
    },
    {
      "type": "disk",
      "key": "󰋊",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": "",
      "format": "{4} [{5}]"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
