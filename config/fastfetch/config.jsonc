{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "cachyos",
    "padding": {
      "right": 3,
      "left": 0
    },
    "color": {
      "1": "#a7d63b",
      "2": "#b8cf63"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#a7d63b",
      "title": "#b8cf86"
    },
    "percent": {
      "color": {
        "green": "#48e186",
        "yellow": "#a7d63b",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "󰣇",
      "keyColor": "cyan",
      "format": "{3}"
    },
    {
      "type": "host",
      "key": "󰌢",
      "keyColor": "cyan",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "cyan",
      "format": "{1} {2}"
    },
    {
      "type": "uptime",
      "key": "󰅐",
      "keyColor": "cyan"
    },
    {
      "type": "processes",
      "key": "󰒋",
      "keyColor": "cyan",
      "format": "{1} ({2} threads)"
    },
    {
      "type": "packages",
      "key": "󰏖",
      "keyColor": "cyan"
    },
    {
      "type": "break"
    },
    {
      "type": "wm",
      "key": "󱂬",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "",
      "keyColor": "magenta"
    },
    {
      "type": "display",
      "key": "󰍹",
      "keyColor": "magenta",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "theme",
      "key": "󰉼",
      "keyColor": "magenta"
    },
    {
      "type": "break"
    },
    {
      "type": "cpu",
      "key": "󰍛",
      "keyColor": "green",
      "format": "{1} ({4}) @ {7}"
    },
    {
      "type": "gpu",
      "key": "󰾲",
      "keyColor": "green",
      "format": "{2}",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "󰋊",
      "keyColor": "green",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "battery",
      "key": "",
      "keyColor": "green",
      "format": "{4} [{5}]"
    },
    {
      "type": "localip",
      "key": "󰩟",
      "keyColor": "green",
      "format": "{ipv4}"
    },
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
