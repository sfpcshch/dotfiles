<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="root-menu" label="Desktop">
    <item label="Next Wallpaper">
      <action name="Execute" command="wallpaper-cycle.sh next" />
    </item>
    <item label="Previous Wallpaper">
      <action name="Execute" command="wallpaper-cycle.sh prev" />
    </item>
    <item label="Wallpaper Source">
      <action name="Execute" command="wallpaper-info.sh" />
    </item>
    <separator />
    <item label="Terminal">
      <action name="Execute" command="alacritty" />
    </item>
    <separator />
    <item label="Settings">
      <action name="Execute" command="noctalia msg settings-open" />
    </item>
    <item label="Reload Desktop">
      <action name="Execute" command="sh -c 'labwc --reconfigure; noctalia msg config-reload'" />
    </item>
  </menu>
</openbox_menu>
