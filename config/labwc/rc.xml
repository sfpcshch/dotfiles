<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <theme>
    <!-- Use noctalia theme with sharp rectangular window controls -->
    <name>noctalia</name>
    <cornerRadius>0</cornerRadius>
    <titlebar>
      <!-- Windows layout: App icon on left; Minimize, Maximize, Close on top right -->
      <layout>icon:iconify,max,close</layout>
    </titlebar>
  </theme>

  <!-- Focus model: click to focus, raise on focus -->
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>

  <!-- Aero Snap: drag window to screen edges to snap or maximize -->
  <snapping>
    <range inner="15" outer="15" />
    <cornerRange>50</cornerRange>
    <overlay enabled="yes">
      <!-- Zero delay: snap preview overlay appears immediately -->
      <delay inner="0" outer="0" />
    </overlay>
  </snapping>

  <!-- Edge resistance when dragging windows -->
  <resist>
    <screen>20</screen>
    <windows>20</windows>
  </resist>

  <!-- Mouse bindings: drag titlebar to move, double click to maximize -->
  <mouse>
    <default />

    <!-- Disable desktop scroll switching to prevent accidental workspace jumps -->
    <!-- Right click opens desktop menu -->
    <context name="Root">
      <mousebind direction="Up" action="Scroll" />
      <mousebind direction="Down" action="Scroll" />
      <mousebind direction="Left" action="Scroll" />
      <mousebind direction="Right" action="Scroll" />
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
    <context name="Desktop">
      <mousebind direction="Up" action="Scroll" />
      <mousebind direction="Down" action="Scroll" />
      <mousebind direction="Left" action="Scroll" />
      <mousebind direction="Right" action="Scroll" />
    </context>
    <context name="TitleBar">
      <mousebind direction="Up" action="Scroll" />
      <mousebind direction="Down" action="Scroll" />
    </context>
  </mouse>

  <!-- Single persistent workspace -->
  <desktops number="1" />

  <!-- Window Switcher (Task View / Alt+Tab) with thumbnail OSD preview -->
  <windowSwitcher preview="yes" outlines="yes" order="focus">
    <osd show="yes" style="thumbnail" output="focused" />
  </windowSwitcher>

  <!-- Keyboard bindings -->
  <keyboard>
    <default />

    <!-- Win + Tab: Task View thumbnail grid switcher -->
    <keybind key="W-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="W-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- Alt + Tab: Window switcher with thumbnail OSD -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- Win + S: Search / App Launcher (Windows standard) -->
    <keybind key="W-s">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>

    <!-- Win + R: App Launcher / Run Dialog -->
    <keybind key="W-r">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>

    <!-- Win + W: Cycle to next wallpaper -->
    <keybind key="W-w">
      <action name="Execute" command="wallpaper-cycle.sh next" />
    </keybind>
    <!-- Win + Shift + W: Cycle to previous wallpaper -->
    <keybind key="W-S-w">
      <action name="Execute" command="wallpaper-cycle.sh prev" />
    </keybind>

    <!-- Windows key (Super) to toggle Start Menu on key release -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>

    <!-- Win + E: Open File Explorer (Dolphin) -->
    <keybind key="W-e">
      <action name="Execute" command="env QT_QPA_PLATFORMTHEME=qt6ct dolphin" />
    </keybind>

    <!-- Win + B: Launch Web Browser (Brave) -->
    <keybind key="W-b">
      <action name="Execute" command="brave-origin" />
    </keybind>

    <!-- Win + Enter, Win + T, or Ctrl + Alt + T: Open Terminal (Alacritty) -->
    <keybind key="W-Return">
      <action name="Execute" command="alacritty" />
    </keybind>
    <keybind key="W-t">
      <action name="Execute" command="alacritty" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="alacritty" />
    </keybind>

    <!-- Win + Arrows: Maximize, minimize/restore, and snap window left/right -->
    <keybind key="W-Up">
      <action name="Maximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="If">
        <query maximized="both" />
        <then>
          <action name="UnMaximize" />
        </then>
        <else>
          <action name="Iconify" />
        </else>
      </action>
    </keybind>
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>

    <!-- Win + D: Minimize all / Show Desktop -->
    <keybind key="W-d">
      <action name="ToggleShowDesktop" />
    </keybind>

    <!-- Win + L: Lock screen via Noctalia Lockscreen -->
    <keybind key="W-l">
      <action name="Execute" command="noctalia msg session lock" />
    </keybind>

    <!-- Win + X: Power & Session menu -->
    <keybind key="W-x">
      <action name="Execute" command="noctalia msg panel-toggle session" />
    </keybind>

    <!-- Win + A: Control Center / Quick Settings -->
    <keybind key="W-a">
      <action name="Execute" command="noctalia msg panel-toggle control-center" />
    </keybind>

    <!-- Win + N: Notifications panel -->
    <keybind key="W-n">
      <action name="Execute" command="noctalia msg panel-toggle control-center notifications" />
    </keybind>

    <!-- Win + V: Clipboard history manager -->
    <keybind key="W-v">
      <action name="Execute" command="noctalia msg panel-toggle clipboard" />
    </keybind>

    <!-- Win + Shift + S: Region screenshot (Snipping Tool) -->
    <keybind key="W-S-s">
      <action name="Execute" command="noctalia msg screenshot-region" />
    </keybind>

    <!-- Ctrl + Shift + Esc: Process Manager (btop) -->
    <keybind key="C-S-Escape">
      <action name="Execute" command="alacritty -e btop" />
    </keybind>

    <!-- Win + I: System Settings -->
    <keybind key="W-i">
      <action name="Execute" command="noctalia msg settings-toggle" />
    </keybind>

    <!-- Win + Q or Alt + F4: Close active window -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>

    <!-- Win + F: Toggle Fullscreen -->
    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>

    <!-- Print Screen: Region and Fullscreen capture -->
    <keybind key="Print">
      <action name="Execute" command="noctalia msg screenshot-region" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="noctalia msg screenshot-fullscreen" />
    </keybind>

    <!-- Fn Keys: Screen Brightness controls with Noctalia OSD -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="noctalia msg brightness-up" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="noctalia msg brightness-down" />
    </keybind>

    <!-- Fn Keys: Volume and Microphone controls with Noctalia OSD -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="noctalia msg volume-up" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="noctalia msg volume-down" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="noctalia msg volume-mute" />
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute" command="noctalia msg mic-mute" />
    </keybind>

    <!-- Fn Keys: Media player controls -->
    <keybind key="XF86AudioPlay">
      <action name="Execute" command="noctalia msg media toggle" />
    </keybind>
    <keybind key="XF86AudioNext">
      <action name="Execute" command="noctalia msg media next" />
    </keybind>
    <keybind key="XF86AudioPrev">
      <action name="Execute" command="noctalia msg media previous" />
    </keybind>
  </keyboard>

  <!-- Touchpad & Pointer input configuration -->
  <libinput>
    <device category="touchpad">
      <!-- Natural scrolling (swipe up to scroll down) -->
      <naturalScroll>yes</naturalScroll>
      <scrollFactor>0.55</scrollFactor>
      <!-- Tap to click, tap and drag -->
      <tap>yes</tap>
      <tapAndDrag>yes</tapAndDrag>
      <!-- 2-finger tap = Right click, 3-finger tap = Middle click -->
      <tapButtonMap>lrm</tapButtonMap>
      <clickMethod>buttonAreas</clickMethod>
      <threeFingerDrag>no</threeFingerDrag>
      <scrollMethod>twoFinger</scrollMethod>
      <disableWhileTyping>yes</disableWhileTyping>
      <accelProfile>adaptive</accelProfile>
      <pointerSpeed>0.0</pointerSpeed>
    </device>

    <!-- Physical External Mouse configuration -->
    <device category="non-touch">
      <!-- Standard wheel scrolling -->
      <naturalScroll>no</naturalScroll>
      <scrollFactor>1.0</scrollFactor>
    </device>
  </libinput>

</labwc_config>
