#!/bin/sh
# xdg-terminal-exec implementation for Alacritty (Portable & Unbreakable)
# Launch detached in user app.slice (or nohup fallback) so temporary scopes cannot kill it

if [ "$1" = "--" ] || [ "$1" = "-e" ]; then
    shift
fi

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export DISPLAY="${DISPLAY:-:0}"

TERM_BIN="$(command -v alacritty || command -v foot || command -v kitty || command -v xterm || echo /usr/bin/alacritty)"

if command -v systemd-run >/dev/null 2>&1; then
    if [ $# -gt 0 ]; then
        systemd-run --user --slice=app.slice "$TERM_BIN" -e "$@" >/dev/null 2>&1
    else
        systemd-run --user --slice=app.slice "$TERM_BIN" >/dev/null 2>&1
    fi
else
    if [ $# -gt 0 ]; then
        nohup "$TERM_BIN" -e "$@" >/dev/null 2>&1 &
    else
        nohup "$TERM_BIN" >/dev/null 2>&1 &
    fi
fi
