#!/bin/sh
# xdg-terminal-exec implementation for Alacritty
# Launch detached in user app.slice so temporary scopes (like notification handlers) cannot kill it

if [ "$1" = "--" ] || [ "$1" = "-e" ]; then
    shift
fi

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export DISPLAY="${DISPLAY:-:0}"

if [ $# -gt 0 ]; then
    systemd-run --user --slice=app.slice /usr/bin/alacritty -e "$@" >/dev/null 2>&1
else
    systemd-run --user --slice=app.slice /usr/bin/alacritty >/dev/null 2>&1
fi

